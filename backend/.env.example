# Copy to backend/.env and fill in. Every setting can also be passed as an
# environment variable (see app/core/config.py for the full list).

# --- Required ---
GOOGLE_API_KEY=your-google-api-key-here
LLM_MODEL=gemini-3.1-flash-lite
# LLM_TEMPERATURE=0.4

# --- MySQL (docker compose uses these to create the database too) ---
DB_USERNAME=salesman
DB_PASSWORD=changeme
DB_NAME=retail_shop
DB_HOST=localhost
DB_PORT=3306

# --- HTTP ---
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to require an X-API-Key header on chat/catalog endpoints.
API_KEY=
RATE_LIMIT_PER_MINUTE=30
REQUEST_TIMEOUT_SECONDS=90
LOG_LEVEL=INFO

# --- Assistant behaviour ---
# HISTORY_WINDOW=12
# CANDIDATES_PER_CATEGORY=6
# PICKS_PER_CATEGORY=3
# MAX_CLARIFYING_QUESTIONS=3
# NORMALIZE_CATALOG_WITH_LLM=true

# --- Company identity (store locations live in app/data/stores.json) ---
COMPANY_NAME=Trein
COMPANY_TAGLINE=Every home, every device -- one store.
COMPANY_WEBSITE=https://www.trein.example.com
COMPANY_SUPPORT_PHONE=1800-000-0000
# STORES_FILE=/path/to/stores.json
