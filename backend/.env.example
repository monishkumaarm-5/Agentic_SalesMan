# Copy to .env and fill in real values.
#
# Used directly by `docker compose up` (see docker-compose.yml). For a
# non-Docker local run, config.py's os.getenv(...) fallbacks read these same
# variable names if they're exported in your shell or picked up from a local
# .env by python-dotenv -- see config.dummy.py.

# --- Required ---
GOOGLE_API_KEY=your-google-api-key-here

# --- MySQL ---
# In Docker Compose these are also used to provision the mysql service
# itself (MYSQL_USER / MYSQL_PASSWORD / MYSQL_DATABASE / root password), so
# set them here even though they default to dev-only placeholders.
DB_USERNAME=salesman
DB_PASSWORD=changeme
DB_NAME=retail_shop
# DB_HOST / DB_PORT are not read from here in Docker Compose -- they're
# pinned to the "mysql" service in docker-compose.yml. Only relevant for a
# non-Docker run against an external MySQL server.
DB_HOST=localhost
DB_PORT=3306

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- API auth (optional) ---
# Leave empty to keep the API open (fine for local dev). Set a value to
# require an "X-API-Key" header on /api/chat and /api/history/*.
API_KEY=

# --- Rate limiting / timeouts ---
RATE_LIMIT_PER_MINUTE=20
# Higher than a "simple chatbot" default -- a sales turn now makes several
# LLM calls (entry guard, requirement extraction, the 4-agent crew, the
# evaluator, and occasionally one evaluator-triggered retry).
REQUEST_TIMEOUT_SECONDS=90

# --- Logging ---
LOG_LEVEL=INFO

# --- Evaluator / retry ---
# Minimum average score (0-1) for a sales-agent answer to pass the exit
# evaluator without a retry. See AGENTS/EXIT_SAFE_GAURD_AGENT.py.
EVALUATION_MIN_SCORE=0.6
# Whether a failing evaluation triggers one retry of the sales crew before
# falling back to the decline message.
ENABLE_EVALUATOR_RETRY=true
