# Never bake secrets into the image -- real values are supplied at
# `docker run` / `docker compose` time via environment variables.
config.py
.env
.env.local

.git
.github
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
tests/

venv/
env/
ENV/
.venv/

# Vector DB / checkpoints are runtime state, not build input -- persisted via
# a volume instead (see docker-compose.yml).
WORKFLOW/chroma_db/
WORKFLOW/checkpoints.sqlite

# The frontend has its own image/Dockerfile and isn't needed in the backend
# build context.
FRONTEND/

.DS_Store
*.log
